# app2gcal Environment Configuration

# Google Calendar API credentials (JSON string from service account)
# Get from: Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Default calendar ID for events
DEFAULT_CALENDAR_ID=ashantc@euroblaze.de

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://simplify-erp.de

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Environment (dev, stag, prod)
ENVIRONMENT=dev

# Booking calendar ID for consultant bookings
GOOGLE_CALENDAR_ID=sales@simplify-erp.de

# Scoopp research service URL
SCOOPP_URL=http://scoopp-service:8000

# API key for authenticated endpoints (POST /bookings)
API_KEY=

# SSRF allowlist for consultants_url (comma-separated URL prefixes)
CONSULTANTS_URL_ALLOWLIST=https://simplify-erp.de,http://frontend-service
